# yamlfmt configuration for limensafe
# This file configures yamlfmt to match goneat's YAML formatting preferences

formatter:
  type: basic
  indent: 2
  line_ending: lf
  # pad_line_comments: 2 matches existing repo content (`key: value  # comment`).
  # Unset, yamlfmt defaults to 1 and rewrites every inline comment, churning files
  # that goneat-format already considers clean (per @dave-3leaps's appnote;
  # goneat v0.5.12 will codify this alignment upstream).
  pad_line_comments: 2
  # eof_newline: false - goneat's finalizer handles EOF normalization (single trailing newline)
  # so we don't need yamlfmt to add one (which would cause instability with multiline scalars)
  # retain_line_breaks_single: false - causes #magic___^_^___line markers in output, yamlfmt bug
  # Note: yamlfmt doesn't support all the options goneat tracks:
  # - quote_style (single/double)
  # - trailing_newline control
  # These would need to be enforced by other means or accepted as yamlfmt defaults

# Exclude patterns
# Note: ".git" is intentionally NOT in this list — in a git worktree, .git is
# a file (gitfile) not a directory, and yamlfmt's "stat .git/**" fails with
# "not a directory". yamlfmt only processes .yaml/.yml files anyway, so the
# git internal store is naturally skipped.
exclude:
  - node_modules/**
  - vendor/**
  - dist/**
  - bin/**
