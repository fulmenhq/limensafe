# Limensafe Environment Variables
#
# Copy this file to .env and customize for your environment.
# The .env file is gitignored and will not be committed.
#
# Env vars support both canonical (nested) and alias (short) forms.
# If both are set with different values, the alias takes precedence
# and a warning is logged. Run `limensafe doctor` to detect conflicts.
#
# Sensitive values (TOKEN, SECRET, PASSWORD, KEY) are masked in
# diagnostic output (`limensafe envinfo`, `limensafe doctor`).

# ─── Application / Server ───────────────────────────────────────────
#
# Canonical                      Alias
# LIMENSAFE_SERVER_HOST          LIMENSAFE_HOST
# LIMENSAFE_SERVER_PORT          LIMENSAFE_PORT

LIMENSAFE_PORT=8080
LIMENSAFE_HOST=localhost

# ─── Logging ────────────────────────────────────────────────────────
#
# Canonical                      Alias
# LIMENSAFE_LOGGING_LEVEL        LIMENSAFE_LOG_LEVEL
# LIMENSAFE_LOGGING_PROFILE      LIMENSAFE_LOG_PROFILE

LIMENSAFE_LOG_LEVEL=info
# Options: trace, debug, info, warn, error
# LIMENSAFE_LOG_PROFILE=STRUCTURED
# Options: SIMPLE, STRUCTURED, ENTERPRISE

# ─── Metrics and Health ─────────────────────────────────────────────
#
# No aliases (canonical only)

LIMENSAFE_METRICS_ENABLED=true
LIMENSAFE_METRICS_PORT=9090
LIMENSAFE_HEALTH_ENABLED=true

# ─── Server Timeouts ────────────────────────────────────────────────
#
# Canonical                          Alias
# LIMENSAFE_SERVER_READ_TIMEOUT      LIMENSAFE_READ_TIMEOUT
# LIMENSAFE_SERVER_WRITE_TIMEOUT     LIMENSAFE_WRITE_TIMEOUT
# LIMENSAFE_SERVER_IDLE_TIMEOUT      LIMENSAFE_IDLE_TIMEOUT
# LIMENSAFE_SERVER_SHUTDOWN_TIMEOUT  LIMENSAFE_SHUTDOWN_TIMEOUT

LIMENSAFE_READ_TIMEOUT=30s
LIMENSAFE_WRITE_TIMEOUT=30s
LIMENSAFE_IDLE_TIMEOUT=120s
LIMENSAFE_SHUTDOWN_TIMEOUT=10s

# ─── Worker Configuration ───────────────────────────────────────────

LIMENSAFE_WORKERS=4

# ─── Debug Options ──────────────────────────────────────────────────
#
# Canonical                      Alias
# LIMENSAFE_DEBUG_ENABLED        LIMENSAFE_DEBUG
# LIMENSAFE_DEBUG_PPROF_ENABLED  LIMENSAFE_PPROF_ENABLED

# LIMENSAFE_DEBUG=false
# LIMENSAFE_PPROF_ENABLED=false

# ─── Control Plane (Operational Endpoints) ──────────────────────────
#
# Dedicated loopback-bound server for operational control.
# WARNING: Only bind to non-loopback interfaces with strong
# authentication and restricted network access.
#
# Canonical                              Alias
# LIMENSAFE_CONTROL_PLANE_ENABLED        LIMENSAFE_CONTROLPLANE_ENABLED
# LIMENSAFE_CONTROL_PLANE_HOST           LIMENSAFE_CONTROLPLANE_HOST
# LIMENSAFE_CONTROL_PLANE_PORT           LIMENSAFE_CONTROLPLANE_PORT
# LIMENSAFE_CONTROL_PLANE_BASE_PATH      LIMENSAFE_CONTROLPLANE_BASEPATH
# LIMENSAFE_CONTROL_PLANE_BEARER_TOKEN   LIMENSAFE_CONTROLPLANE_BEARERTOKEN

# LIMENSAFE_CONTROL_PLANE_ENABLED=true
# LIMENSAFE_CONTROL_PLANE_HOST=127.0.0.1
# LIMENSAFE_CONTROL_PLANE_PORT=9091
# LIMENSAFE_CONTROL_PLANE_BASE_PATH=/control
# LIMENSAFE_CONTROL_PLANE_BEARER_TOKEN=your-secret-token-here

# ─── Data Plane Auth (Optional Starter Framework) ───────────────────
#
# Optional auth for the primary API surface. Disabled by default.
# CDRL users should replace with their preferred auth strategy.
#
# Canonical                                  Alias
# LIMENSAFE_DATA_PLANE_AUTH_ENABLED          LIMENSAFE_DATAPLANEAUTH_ENABLED
# LIMENSAFE_DATA_PLANE_AUTH_MODE             LIMENSAFE_DATAPLANEAUTH_MODE
# LIMENSAFE_DATA_PLANE_AUTH_BEARER_TOKEN     LIMENSAFE_DATAPLANEAUTH_BEARERTOKEN
# LIMENSAFE_DATA_PLANE_AUTH_BASIC_USERNAME   LIMENSAFE_DATAPLANEAUTH_BASIC_USERNAME
# LIMENSAFE_DATA_PLANE_AUTH_BASIC_PASSWORD   LIMENSAFE_DATAPLANEAUTH_BASIC_PASSWORD

# LIMENSAFE_DATA_PLANE_AUTH_ENABLED=false
# LIMENSAFE_DATA_PLANE_AUTH_MODE=disabled
# Options: disabled, bearerToken, basicAuth
# LIMENSAFE_DATA_PLANE_AUTH_BEARER_TOKEN=your-api-token-here
# LIMENSAFE_DATA_PLANE_AUTH_BASIC_USERNAME=admin
# LIMENSAFE_DATA_PLANE_AUTH_BASIC_PASSWORD=changeme

# ─── Configuration File Path ────────────────────────────────────────
#
# If not set, uses XDG config dir: ~/.config/limensafe/config.yaml
# LIMENSAFE_CONFIG_PATH=./config/limensafe.yaml

# ─── Database Configuration (if needed) ─────────────────────────────
#
# LIMENSAFE_DB_DSN=postgres://user:pass@localhost:5432/dbname
# LIMENSAFE_DB_MAX_CONNECTIONS=25
# LIMENSAFE_DB_MAX_IDLE=5

# ─── External Services (examples) ───────────────────────────────────
#
# LIMENSAFE_API_KEY=your-api-key-here
# LIMENSAFE_EXTERNAL_URL=https://api.example.com
