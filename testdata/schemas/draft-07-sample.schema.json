{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "test/draft-07-sample",
  "title": "Draft-07 Sample Schema",
  "description": "Test fixture demonstrating Draft-07 schema validation",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "enabled": {
      "type": "boolean"
    },
    "comment": {
      "$comment": "Draft-07 introduced $comment",
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "additionalProperties": false,
  "if": {
    "properties": {
      "enabled": {
        "const": true
      }
    }
  },
  "then": {
    "required": [
      "count"
    ]
  }
}
